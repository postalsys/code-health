<!DOCTYPE html>
<html lang="en" class="ee-app-chrome">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Size, complexity and maintainability index of EmailEngine and the libraries it is built on, measured at every release.">
    <title>{{pageTitle}}</title>

    <link rel="apple-touch-icon" href="/static/favicon/apple-touch-icon.png" sizes="180x180" />
    <link rel="icon" href="/static/favicon/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/static/favicon/favicon-16x16.png" sizes="16x16" type="image/png" />

    {{> theme_init}}

    <link href="/static/fonts/pt-sans-font.css" rel="stylesheet">
    <link href="/static/css/app.css" rel="stylesheet">
</head>

<body class="bg-base-200 min-h-screen">

    <!-- Sidebar, the same shell as the EmailEngine admin UI -->
    <aside id="layout-sidebar"
        class="overlay overlay-open:translate-x-0 drawer drawer-start w-sidebar max-w-full inset-y-0 start-0 hidden h-full [--auto-close:lg] lg:z-40 lg:block lg:translate-x-0 lg:shadow-none"
        aria-label="Sidebar" tabindex="-1">
        <div class="drawer-body bg-base-100 border-base-content/20 flex h-full flex-col border-e p-0">

            <button type="button" class="btn btn-text btn-circle btn-sm absolute end-3 top-3 lg:hidden"
                aria-label="Close" data-overlay="#layout-sidebar">
                <span class="icon-[tabler--x] size-4"></span>
            </button>

            <div class="border-base-content/20 flex items-center justify-center border-b px-6 py-5">
                <a href="/" class="flex items-center">
                    <img src="/static/logo/EmailEngine_logo_horiz.png" alt="EmailEngine" class="block max-h-8 max-w-full">
                </a>
            </div>

            <div class="grow overflow-y-auto">
                <ul class="menu menu-sm w-full gap-1 p-4">
                    {{> ui/menu-item href="/" label="Overview" icon="icon-[tabler--dashboard] size-4.5" active=menuOverview}}

                    {{> ui/menu-title label="Application"}}
                    {{#each menuApps}}
                    {{> ui/menu-item href=href label=name icon="icon-[tabler--mail-cog] size-4.5" active=active}}
                    {{/each}}

                    {{> ui/menu-title label="Libraries"}}
                    {{#each menuLibraries}}
                    {{> ui/menu-item href=href label=name icon="icon-[tabler--package] size-4.5" active=active}}
                    {{/each}}
                </ul>
            </div>

        </div>
    </aside>

    <div class="flex min-h-screen flex-col lg:ps-sidebar">

        <header class="bg-base-100 border-base-content/20 sticky top-0 z-30 border-b">
            <nav class="navbar flex flex-wrap items-center gap-2 px-6 py-2">
                <button type="button" class="btn btn-text btn-circle btn-sm lg:hidden" aria-haspopup="dialog"
                    aria-expanded="false" aria-controls="layout-sidebar" data-overlay="#layout-sidebar"
                    aria-label="Open menu">
                    <span class="icon-[tabler--menu-2] size-5"></span>
                </button>

                <span class="text-base-content/70 grow text-sm">Code health</span>

                <div class="flex items-center gap-1">
                    {{#> ui/tooltip text="Source and data on GitHub" placement="bottom"}}
                    <a href="{{sourceUrl}}" class="btn btn-text btn-circle btn-sm" aria-label="Source and data on GitHub">
                        <span class="icon-[tabler--brand-github] size-5"></span>
                    </a>
                    {{/ui/tooltip}}

                    <button type="button" class="theme-toggle-btn btn btn-text btn-circle btn-sm" aria-label="Toggle theme">
                        <span class="theme-toggle-dark icon-[tabler--moon] size-5"></span>
                        <span class="theme-toggle-light icon-[tabler--sun] size-5 hidden"></span>
                    </button>
                </div>
            </nav>
        </header>

        <div id="content" class="grow">
            <div class="w-full min-w-0 px-6 py-6">
                {{{body}}}

                <p class="text-base-content/50 mt-8 text-xs">Measured {{updated}}.</p>
            </div>
        </div>
    </div>

    <script src="/static/js/flyonui.js"></script>
    <script src="/static/js/ui.js"></script>
    <script src="/static/js/charts.js"></script>
</body>

</html>
